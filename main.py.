from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.label import Label
from kivy.uix.textinput import TextInput
from kivy.uix.button import Button
from kivy.uix.scrollview import ScrollView
from kivy.core.window import Window

# Set background theme
Window.clearcolor = (0.1, 0.1, 0.12, 1)

class AdexAiApp(App):
    def build(self):
        self.title = "ADEX AI"
        
        # Main layout container
        root = BoxLayout(orientation='vertical', padding=15, spacing=10)

        # Header Title
        header = Label(
            text="[b]ADEX AI Assistant[/b]",
            markup=True,
            font_size='22sp',
            size_hint_y=None,
            height=40,
            color=(0.2, 0.7, 1, 1)
        )
        root.add_widget(header)

        # Scrollable Chat Area
        self.scroll = ScrollView(size_hint=(1, 1))
        self.chat_history = Label(
            text="Welcome to ADEX AI! Type a message below to start...\n\n",
            size_hint_y=None,
            font_size='15sp',
            halign='left',
            valign='top',
            color=(0.9, 0.9, 0.9, 1)
        )
        self.chat_history.bind(texture_size=self._update_text_height)
        self.chat_history.bind(width=self._update_text_width)
        
        self.scroll.add_widget(self.chat_history)
        root.add_widget(self.scroll)

        # Input and Send Button Row
        input_row = BoxLayout(orientation='horizontal', size_hint_y=None, height=50, spacing=10)
        
        self.text_input = TextInput(
            hint_text="Ask ADEX AI anything...",
            multiline=False,
            background_color=(0.2, 0.2, 0.24, 1),
            foreground_color=(1, 1, 1, 1),
            cursor_color=(0.2, 0.7, 1, 1)
        )
        self.text_input.bind(on_text_validate=self.send_message)
        
        send_btn = Button(
            text="Send",
            size_hint_x=None,
            width=90,
            background_color=(0.2, 0.6, 1, 1),
            color=(1, 1, 1, 1)
        )
        send_btn.bind(on_press=self.send_message)

        input_row.add_widget(self.text_input)
        input_row.add_widget(send_btn)
        root.add_widget(input_row)

        return root

    def _update_text_height(self, instance, value):
        instance.height = value[1]

    def _update_text_width(self, instance, value):
        instance.text_size = (value[0], None)

    def send_message(self, instance):
        user_text = self.text_input.text.strip()
        if user_text:
            self.chat_history.text += f"[b]You:[/b] {user_text}\n"
            self.chat_history.text += f"[b]ADEX AI:[/b] Received! Engine ready.\n\n"
            self.text_input.text = ""

if __name__ == "__main__":
    AdexAiApp().run()
